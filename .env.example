# ─────────────────────────────────────────────────────────────
# 主要 AI：Cloudflare Workers AI
# 不需要任何 API Key —— 走 wrangler.toml 的 [ai] binding。
# 只有想換模型時才需要設定：
# WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# ─────────────────────────────────────────────────────────────

# 備援：Groq（免費、推論極快、OpenAI 相容介面）
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# GROQ_MODEL=llama-3.3-70b-versatile

# 選配：OpenAI（現場若有發 credits，設了就會自動接上，不用改程式碼）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Track D：ElevenLabs 語音轉文字（選配，沒設定時語音按鈕會自動降級為純文字輸入）
# ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx
# ELEVENLABS_STT_MODEL=scribe_v1

# 以上全部都是 server-side only，絕不可加 NEXT_PUBLIC_ 前綴。
